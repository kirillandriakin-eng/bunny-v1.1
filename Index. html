function playBoneSound(){if(masterVolume<=0)return;const c=getAudioCtx();if(!c)return;try{const n=c.currentTime;[{t:0,f:2200,q:8,v:0.35,dur:0.05},{t:0.07,f:1800,q:6,v:0.28,dur:0.05},{t:0.14,f:2500,q:10,v:0.22,dur:0.04}].forEach(h=>{const bs=Math.floor(c.sampleRate*h.dur),b=c.createBuffer(1,bs,c.sampleRate),dd=b.getChannelData(0);for(let i=0;i<bs;i++){const e=Math.pow(1-i/bs,3);dd[i]=(Math.random()*2-1)*e}const s=c.createBufferSource();s.buffer=b;const f=c.createBiquadFilter();f.type='bandpass';f.frequency.value=h.f;f.Q.value=h.q;const g=c.createGain();g.gain.setValueAtTime(vol(h.v),n+h.t);g.gain.exponentialRampToValueAtTime(0.001,n+h.t+h.dur);s.connect(f);f.connect(g);g.connect(c.destination);s.start(n+h.t);s.stop(n+h.t+h.dur);const o=c.createOscillator(),og=c.createGain();o.type='square';o.frequency.setValueAtTime(400,n+h.t);o.frequency.exponentialRampToValueAtTime(150,n+h.t+h.dur);og.gain.setValueAtTime(vol(h.v*0.4),n+h.t);og.gain.exponentialRampToValueAtTime(0.001,n+h.t+h.dur);o.connect(og);og.connect(c.destination);o.start(n+h.t);o.stop(n+h.t+h.dur)})}catch(e){}}
</script>
<script>
const SAVE_KEY='bunnySave_v21_loot2',MAX_LEVEL=20;
const CLICK_VALUES=[1,2,4,8,16,32,64,128,256,512,1024,2048,4096,8192,16384,32768,65536,131072,262144,524288];
const PASSIVE_VALUES=[1,2,4,8,12,20,30,80,160,320,600,1000,2200,4500,9000,14000,30000,55000,120000,250000];
const ENERGY_MAX=[20,40,60,120,220,400,800,1300,2500,8000,22000,34000,60000,120000,250000,400000,800000,1500000,3000000,8000000];
const ENERGY_RATE=[1,2,3,6,10,18,35,50,100,200,450,800,1500,4000,10000,16000,50000,120000,250000,500000];
const COST_CLICK={1:100,2:300,3:1000,4:4000,5:15000,6:50000,7:120000,8:300000,9:700000,10:1800000,11:4500000,12:12000000,13:35000000,14:100000000,15:250000000,16:600000000,17:1500000000,18:4000000000,19:10000000000};
const COST_PASSIVE={1:150,2:500,3:2000,4:8000,5:30000,6:90000,7:220000,8:500000,9:1200000,10:3000000,11:7500000,12:20000000,13:55000000,14:150000000,15:400000000,16:900000000,17:2200000000,18:6000000000,19:15000000000};
const COST_ENERGY={1:200,2:800,3:3000,4:12000,5:45000,6:120000,7:280000,8:650000,9:1500000,10:3800000,11:9500000,12:25000000,13:70000000,14:200000000,15:500000000,16:1200000000,17:3000000000,18:8000000000,19:20000000000};
const SKINS=[{id:0,price:0,bonus:0},{id:1,price:3000,bonus:1000},{id:2,price:50000,bonus:8000},{id:3,price:500000,bonus:150000},{id:4,price:50000000,bonus:10000000},{id:5,price:1000000000,bonus:50000000},{id:6,price:50000000000,bonus:5000000000},{id:7,price:3000000000000,bonus:300000000000}];
const CODES={'#Bunny':300,'Мой кролик':500,'100300500':250,'Люблю кролика':500,'Китёнок':1000,'Ледниковый период-Жарко=Зайчик':50000000000000};
const BOX_TYPES={money:{id:'money',chance:72,time:60},buff:{id:'buff',chance:22,time:180},pet:{id:'pet',chance:6,time:600}};
const BUFF_LOOT=[{id:'b1',stat:'click',mult:2,time:300,chance:23,icon:'👆'},{id:'b2',stat:'energy',mult:2,time:300,chance:27,icon:'⚡'},{id:'b3',stat:'click',mult:3,time:300,chance:10,icon:'👆'},{id:'b4',stat:'energy',mult:3,time:180,chance:14,icon:'⚡'},{id:'b5',stat:'passive',mult:5,time:120,chance:3,icon:'💸'},{id:'b6',stat:'click',mult:3,time:60,chance:21,icon:'👆'},{id:'b7',stat:'click',mult:6,time:80,chance:2,icon:'🔥'}];
const PET_LOOT=[{id:'cat5',type:'cat',nameKey:'pet_cat',time:300,timeText:'5 мин',icon:'🐱',stat:'click',mult:3,chance:30},{id:'cat10',type:'cat',nameKey:'pet_cat',time:600,timeText:'10 мин',icon:'🐱',stat:'click',mult:3,chance:15},{id:'dog5',type:'dog',nameKey:'pet_dog',time:300,timeText:'5 мин',icon:'🐶',stat:'energy',mult:3,chance:30},{id:'dog10',type:'dog',nameKey:'pet_dog',time:600,timeText:'10 мин',icon:'🐶',stat:'energy',mult:3,chance:15},{id:'snake5',type:'snake',nameKey:'pet_snake',time:300,timeText:'5 мин',icon:'🐍',stat:'both',mult:3,chance:8},{id:'cat_forever',type:'cat',nameKey:'pet_cat',time:Infinity,timeText:'',icon:'🐱',stat:'click',mult:3,chance:0.75},{id:'dog_forever',type:'dog',nameKey:'pet_dog',time:Infinity,timeText:'',icon:'🐶',stat:'energy',mult:3,chance:0.75},{id:'snake_forever',type:'snake',nameKey:'pet_snake',time:Infinity,timeText:'',icon:'🐍',stat:'both',mult:3,chance:0.5}];
const defaultState=()=>({coins:0,energy:20,lvlClick:1,lvlPassive:1,lvlEnergy:1,ownedSkins:[0],equippedSkin:0,usedCodes:[],lang:'ru',volume:1,seeds:0,flytrapUnlocked:false,nestBoxes:[],overflowBoxes:0,buffs:[],pets:[]});
let state=load(),serverTimeOffset=0;
function load(){try{const raw=localStorage.getItem(SAVE_KEY);if(raw){const p=JSON.parse(raw),m=Object.assign(defaultState(),p);currentLang=m.lang||'ru';masterVolume=m.volume!==undefined?m.volume:1;return m}}catch(e){}return defaultState()}
function save(){try{state.lang=currentLang;state.volume=masterVolume;localStorage.setItem(SAVE_KEY,JSON.stringify(state))}catch(e){}}
const $=id=>document.getElementById(id),now=()=>Date.now()+serverTimeOffset;
const clickValue=()=>CLICK_VALUES[state.lvlClick-1];
const passiveValue=()=>PASSIVE_VALUES[state.lvlPassive-1];
const energyMax=()=>ENERGY_MAX[state.lvlEnergy-1];
const energyRate=()=>ENERGY_RATE[state.lvlEnergy-1];
const isGoldenSeed=()=>(state.lvlClick>=19||state.lvlPassive>=19||state.lvlEnergy>=19);
const seedCost=()=>isGoldenSeed()?100000000:10000000;
function formatNumber(n){if(n<1_000_000)return Math.floor(n).toLocaleString(currentLang==='ru'?'ru-RU':'en-US');if(n<1_000_000_000)return (Math.round(n/100000)/10).toFixed(1).replace('.',currentLang==='ru'?',':'.')+'M';if(n<1_000_000_000_000)return (Math.round(n/100000000)/10).toFixed(1).replace('.',currentLang==='ru'?',':'.')+'B';let t=n/1_000_000_000_000,str=t.toFixed(2).replace('.',currentLang==='ru'?',':'.');if(str.endsWith('0'))str=str.slice(0,-1);if(str.endsWith('0'))str=str.slice(0,-1);return str+'T'}
function getMultipliers(){let clickMult=1,energyMult=1,passiveMult=1;const t=now();state.buffs=state.buffs.filter(b=>b.endTime>t);state.buffs.forEach(b=>{if(b.stat==='click')clickMult*=b.mult;if(b.stat==='energy')energyMult*=b.mult;if(b.stat==='passive')passiveMult*=b.mult});state.pets=state.pets.filter(p=>p.endTime>t);state.pets.forEach(p=>{if(p.stat==='click'||p.stat==='both')clickMult*=p.mult;if(p.stat==='energy'||p.stat==='both')energyMult*=p.mult});return{clickMult,energyMult,passiveMult}}

/* === НОВЫЕ ШАНСЫ ДЕНЕЖНЫХ БОКСОВ === */
function getMoneyLoot(){
  if(isGoldenSeed()){
    // 100M — 20%, 500M — 30%, 1B — 40%, 3B — 10%
    return [
      {threshold:90,   reward:3000000000},   // 10% — 3B
      {threshold:50,   reward:1000000000},   // 40% — 1B
      {threshold:20,   reward:500000000},    // 30% — 500M
      {threshold:0,    reward:100000000}     // 20% — 100M
    ];
  }
  // Обычный режим
  return [
    {threshold:95.9, reward:350000000},
    {threshold:79.8, reward:250000000},
    {threshold:59.8, reward:100000000},
    {threshold:39.8, reward:10000000},
    {threshold:23.8, reward:1000000},
    {threshold:11.8, reward:100000},
    {threshold:0,    reward:100000}
  ];
}

function render(){const m=getMultipliers();$('coins').textContent=formatNumber(state.coins);$('seeds').textContent=state.seeds;const seedSvg=isGoldenSeed()?SVG_SEED_GOLD:SVG_SEED;$('seedIconContainer').innerHTML=seedSvg;$('shopSeedIcon').innerHTML=seedSvg.replace('style="display:inline-block;vertical-align:middle"','class="box-icon"');$('buySeedBtn').textContent=formatNumber(seedCost())+' 🪙';const maxE=energyMax()*m.energyMult,pct=Math.max(0,Math.min(100,(state.energy/maxE)*100));$('energyFill').style.width=pct+'%';$('energyText').textContent=`${formatNumber(state.energy)} / ${formatNumber(maxE)}`;const rc=clickValue()*m.clickMult;$('clickValue').textContent=formatNumber(rc)+(m.clickMult>1?` (×${m.clickMult})`:'');const rp=passiveValue()*m.passiveMult;$('passiveValue').textContent=formatNumber(rp)+(m.passiveMult>1?` (×${m.passiveMult})`:'');renderBuffs();renderNest();renderPets();renderFlytrap(seedSvg);const c=$('bunnyContainer');if(c.dataset.skin!==String(state.equippedSkin)){c.innerHTML=getSkinSVG(state.equippedSkin);c.dataset.skin=state.equippedSkin;c.querySelector('svg').addEventListener('click',handleBunnyClick);if(state.equippedSkin===4)c.querySelector('svg').classList.add('friday-glow');if(state.equippedSkin===7)c.querySelector('svg').classList.add('koschei-glow')}renderUpgrades();renderSkins();if(state.overflowBoxes>0){$('overflowBoxes').style.display='flex';$('boxCount').textContent=state.overflowBoxes}else $('overflowBoxes').style.display='none';save()}
function renderBuffs(){const c=$('buffsContainer');c.innerHTML='';const t=now();const active=[...state.buffs];state.pets.forEach(p=>active.push({id:p.id,stat:p.stat,mult:p.mult,endTime:p.endTime,icon:p.icon}));active.forEach(b=>{if(b.endTime===Infinity)return;const tl=Math.max(0,Math.ceil((b.endTime-t)/1000));if(tl<=0)return;const el=document.createElement('div');el.className='buff-tag';el.innerHTML=`${b.icon||'🔥'} ×${b.mult} (${Math.floor(tl/60)}:${(tl%60).toString().padStart(2,'0')})`;c.appendChild(el)})}
function renderPets(){const c=$('petsAround');c.innerHTML='';state.pets.forEach((p,i)=>{if(p.endTime===Infinity){const el=document.createElement('div');el.className='pet-icon';el.style.left=(i*40-20)+'px';el.style.top='-20px';el.textContent=p.icon;c.appendChild(el)}})}
function renderNest(){const area=$('nestArea');area.innerHTML='';const t=now();for(let i=0;i<8;i++){const slot=document.createElement('div');slot.className='nest-slot';const box=state.nestBoxes[i];if(box){const tl=Math.max(0,Math.ceil((box.finishTime-t)/1000));slot.innerHTML=BOX_SVGS[box.type]||'📦';if(tl>0){slot.classList.add('timer');slot.dataset.time=Math.floor(tl/60)+':'+(tl%60).toString().padStart(2,'0');slot.onclick=()=>alert(t('box_opening'))}else{slot.style.animation='floatPet 1s infinite';slot.onclick=()=>openBox(i)}}else{slot.classList.add('empty');slot.textContent='—'}area.appendChild(slot)}}
function renderFlytrap(seedSvg){const svg=$('flytrapSvg'),info=$('flytrapInfo');const seedText=`<span style="display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px">${seedSvg}</span>`;if(state.seeds<10&&!state.flytrapUnlocked){svg.classList.add('locked');info.innerHTML=t('flytrap_open',{n:state.seeds})+' '+seedText;info.style.color='#c0392b'}else if(state.flytrapUnlocked&&state.seeds<10){svg.classList.add('locked');info.innerHTML=t('flytrap_need',{n:state.seeds})+' '+seedText;info.style.color='#c0392b'}else{svg.classList.remove('locked');info.innerHTML=t('flytrap_spin')+' '+seedText;info.style.color='#2e5d4b'}}
function renderUpgrades(){$('lvl-click').textContent=`${t('lvl')} ${state.lvlClick} / ${MAX_LEVEL}`;$('desc-click').textContent=formatNumber(clickValue());const bC=$('buy-click');if(state.lvlClick>=MAX_LEVEL){bC.textContent=t('max');bC.disabled=true}else{const cost=COST_CLICK[state.lvlClick];bC.textContent=`${t('btn_upgrade')} (${formatNumber(cost)} 🪙)`;bC.disabled=state.coins<cost}$('lvl-passive').textContent=`${t('lvl')} ${state.lvlPassive} / ${MAX_LEVEL}`;$('desc-passive').textContent=formatNumber(passiveValue());const bP=$('buy-passive');if(state.lvlPassive>=MAX_LEVEL){bP.textContent=t('max');bP.disabled=true}else{const cost=COST_PASSIVE[state.lvlPassive];bP.textContent=`${t('btn_upgrade')} (${formatNumber(cost)} 🪙)`;bP.disabled=state.coins<cost}$('lvl-energy').textContent=`${t('lvl')} ${state.lvlEnergy} / ${MAX_LEVEL}`;$('desc-energy').textContent=formatNumber(energyMax());const bE=$('buy-energy');if(state.lvlEnergy>=MAX_LEVEL){bE.textContent=t('max');bE.disabled=true}else{const cost=COST_ENERGY[state.lvlEnergy];bE.textContent=`${t('btn_upgrade')} (${formatNumber(cost)} 🪙)`;bE.disabled=state.coins<cost}}
function renderSkins(){SKINS.forEach(s=>{const thumb=$('thumb-'+s.id);if(thumb&&thumb.dataset.done!=='1'){thumb.innerHTML=getSkinSVG(s.id);thumb.dataset.done='1'}const btn=$('skin-btn-'+s.id);if(!btn)return;const priceEl=$('price-'+s.id);if(priceEl)priceEl.textContent=(s.id===0)?t('skin_0_price'):`${formatNumber(s.price)} 🪙 · ${t('bonus')}: +${formatNumber(s.bonus)} 🪙`;const owned=state.ownedSkins.includes(s.id),equipped=state.equippedSkin===s.id;if(equipped){btn.textContent=t('btn_equipped');btn.className='buy equip equipped';btn.disabled=false}else if(owned){btn.textContent=t('btn_equip');btn.className='buy equip';btn.disabled=false}else{btn.textContent=`${t('btn_buy')} (${formatNumber(s.price)} 🪙)`;btn.className='buy';btn.disabled=state.coins<s.price}})}
function handleBunnyClick(e){const svgEl=e.currentTarget,m=getMultipliers(),cost=energyRate();if(state.energy<cost){svgEl.animate([{transform:'translateX(-5px)'},{transform:'translateX(5px)'},{transform:'translateX(0)'}],{duration:150});return}const gain=clickValue()*m.clickMult;state.energy-=cost;state.coins+=gain;if(state.equippedSkin===6)setTimeout(playScientistSound,50);if(state.equippedSkin===7)setTimeout(playBoneSound,50);spawnFloat(e.clientX,e.clientY,'+'+formatNumber(gain));playJumpAnimation(svgEl);playPopSound(1+Math.random()*0.15);if(state.equippedSkin===3)setTimeout(playSwordSound,60);if(state.equippedSkin===4){setTimeout(playKnifeSound,60);spawnBloodEffects(e.clientX,e.clientY)}render()}
function buySeed(){const cost=seedCost();if(state.coins<cost)return;state.coins-=cost;state.seeds++;playBuySound();render()}
function handleFlytrapClick(){if(!state.flytrapUnlocked){if(state.seeds>=10){state.seeds-=10;state.flytrapUnlocked=true;playBuySound();render()}else $('flytrapSvg').animate([{transform:'translateX(-5px)'},{transform:'translateX(5px)'},{transform:'translateX(0)'}],{duration:150});return}if(state.seeds>=10){state.seeds-=10;spawnBoxFromFlytrap()}else $('flytrapSvg').animate([{transform:'translateX(-5px)'},{transform:'translateX(5px)'},{transform:'translateX(0)'}],{duration:150})}
function spawnBoxFromFlytrap(){const r=Math.random()*100;let type='money';if(r>94)type='pet';else if(r>72)type='buff';const bd=BOX_TYPES[type];const box={id:Date.now()+Math.random(),type,finishTime:now()+bd.time*1000};if(state.nestBoxes.length<8){state.nestBoxes.push(box);spawnFlyingBox(box.type)}else state.overflowBoxes++;playPopSound();render()}
function spawnFlyingBox(type){const el=document.createElement('div');el.className='flying-box';el.innerHTML=BOX_SVGS[type]||'📦';const rect=$('flytrapSvg').getBoundingClientRect();el.style.left=(rect.left+rect.width/2-20)+'px';el.style.top=rect.top+'px';document.body.appendChild(el);setTimeout(()=>el.remove(),800)}
function openBox(index){const box=state.nestBoxes[index];if(!box||now()<box.finishTime)return;state.nestBoxes.splice(index,1);if(box.type==='money'){const roll=Math.random()*100;const loot=getMoneyLoot();let reward=loot[loot.length-1].reward;for(const l of loot){if(roll>l.threshold){reward=l.reward;break}}state.coins+=reward;showModal(t('modal_money_title'),SVG_BOX_MONEY,t('modal_money_desc'),formatNumber(reward)+' '+t('coins_word'));playBuySound()}else if(box.type==='buff'){const roll=Math.random()*100;let acc=0,drop=BUFF_LOOT[0];for(const b of BUFF_LOOT){acc+=b.chance;if(roll<=acc){drop=b;break}}state.buffs.push({id:Date.now(),stat:drop.stat,mult:drop.mult,endTime:now()+drop.time*1000,icon:drop.icon});const label=drop.stat==='click'?t('stat_click'):drop.stat==='energy'?t('up_energy_name'):t('stat_passive');showModal(t('modal_buff_title'),SVG_BOX_BUFF,t('modal_buff_desc'),`${drop.icon} ×${drop.mult} ${label} (${Math.floor(drop.time/60)} ${t('modal_min')})`);playBuySound()}else if(box.type==='pet'){const roll=Math.random()*100;let acc=0,drop=PET_LOOT[0];for(const p of PET_LOOT){acc+=p.chance;if(roll<=acc){drop=p;break}}state.pets.push({id:Date.now(),type:drop.type,stat:drop.stat,mult:drop.mult,endTime:drop.time===Infinity?Infinity:now()+drop.time*1000,icon:drop.icon});const petName=t(drop.nameKey);if(drop.time===Infinity)showModal(t('modal_jackpot'),SVG_BOX_PET,t('modal_forever'),`${drop.icon} ${petName} ${t('modal_always')}`);else showModal(t('modal_pet_title'),SVG_BOX_PET,t('modal_pet_desc'),`${drop.icon} ${petName} (${drop.timeText})`);playBuySound()}if(state.overflowBoxes>0){state.overflowBoxes--;state.nestBoxes.push({id:Date.now(),type:'money',finishTime:now()+60000})}render()}
setInterval(()=>{const m=getMultipliers();state.coins+=passiveValue()*m.passiveMult;const maxE=energyMax()*m.energyMult;if(state.energy<maxE)state.energy=Math.min(maxE,state.energy+energyRate()*m.energyMult);render()},1000);
function showModal(title,svgIcon,d1,d2){$('modalTitle').textContent=title;$('modalIcon').innerHTML=svgIcon;$('modalDesc').innerHTML=`${d1}<br><b style="font-size:20px;color:#ff9800">${d2}</b>`;$('modalOverlay').classList.add('active')}
function closeModal(){$('modalOverlay').classList.remove('active')}
function spawnFloat(x,y,text){const el=document.createElement('div');el.className='float-coin';el.textContent=text;const wr=$('bunnyWrap').getBoundingClientRect();el.style.left=(x-wr.left)+'px';el.style.top=(y-wr.top)+'px';$('bunnyWrap').appendChild(el);setTimeout(()=>el.remove(),900)}
function spawnBloodEffects(x,y){const wr=$('bunnyWrap').getBoundingClientRect();const left=x-wr.left,top=y-wr.top;for(let i=0;i<3;i++){const s=document.createElement('div');s.className='blood-spark';s.style.left=left+'px';s.style.top=top+'px';const dx=(Math.random()-0.5)*20,dy=(Math.random()-0.5)*20;s.style.transform=`translate(-50%,-50%) translate(${dx}px, ${dy}px)`;$('bunnyWrap').appendChild(s);setTimeout(()=>s.remove(),500)}}
function playJumpAnimation(el){el.classList.remove('jump');void el.getBoundingClientRect();el.classList.add('jump');setTimeout(()=>el.classList.remove('jump'),400)}
document.querySelectorAll('.tab').forEach(tab=>{tab.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));tab.classList.add('active');$('panel-'+tab.dataset.tab).classList.add('active')})});
$('settingsBtn').addEventListener('click',()=>{$('settingsOverlay').classList.add('active');$('langRu').classList.toggle('active',currentLang==='ru');$('langEn').classList.toggle('active',currentLang==='en');$('volumeSlider').value=Math.round(masterVolume*100);$('volumeValue').textContent=masterVolume===0?t('settings_muted'):Math.round(masterVolume*100)+'%'});
function closeSettings(){$('settingsOverlay').classList.remove('active');$('langChoice').style.display='none'}
$('changeLangBtn').addEventListener('click',()=>{const lc=$('langChoice');lc.style.display=lc.style.display==='none'?'block':'none';$('langRu').classList.toggle('active',currentLang==='ru');$('langEn').classList.toggle('active',currentLang==='en')});
function setLanguage(lang){currentLang=lang;$('langRu').classList.toggle('active',lang==='ru');$('langEn').classList.toggle('active',lang==='en');applyLanguage();save()}
$('volumeSlider').addEventListener('input',e=>{masterVolume=e.target.value/100;$('volumeValue').textContent=masterVolume===0?t('settings_muted'):Math.round(masterVolume*100)+'%';save()});
$('volumeSlider').addEventListener('change',()=>{if(masterVolume>0)playPopSound()});
$('buy-click').addEventListener('click',()=>{if(state.lvlClick>=MAX_LEVEL||state.coins<COST_CLICK[state.lvlClick])return;state.coins-=COST_CLICK[state.lvlClick];state.lvlClick++;playBuySound();render()});
$('buy-passive').addEventListener('click',()=>{if(state.lvlPassive>=MAX_LEVEL||state.coins<COST_PASSIVE[state.lvlPassive])return;state.coins-=COST_PASSIVE[state.lvlPassive];state.lvlPassive++;playBuySound();render()});
$('buy-energy').addEventListener('click',()=>{if(state.lvlEnergy>=MAX_LEVEL||state.coins<COST_ENERGY[state.lvlEnergy])return;state.coins-=COST_ENERGY[state.lvlEnergy];state.lvlEnergy++;playBuySound();render()});
SKINS.forEach(s=>{const btn=$('skin-btn-'+s.id);if(btn)btn.addEventListener('click',()=>{const owned=state.ownedSkins.includes(s.id);if(!owned){if(state.coins<s.price)return;state.coins-=s.price;state.ownedSkins.push(s.id);state.equippedSkin=s.id;if(s.bonus>0){state.coins+=s.bonus;spawnFloat(window.innerWidth/2,window.innerHeight/2,t('bonus')+': +'+formatNumber(s.bonus));setTimeout(playBuySound,150)}else playBuySound()}else{state.equippedSkin=s.id;playPopSound(1.2)}$('bunnyContainer').dataset.skin='';render()})});
$('codeBtn').addEventListener('click',()=>{const code=$('codeInput').value.trim(),msg=$('codeMsg');if(!code)return;if(state.usedCodes.includes(code)){msg.textContent=t('code_used');msg.className='msg err';return}if(CODES[code]){state.coins+=CODES[code];state.usedCodes.push(code);msg.textContent=t('code_ok',{n:formatNumber(CODES[code])});msg.className='msg ok';$('codeInput').value='';playBuySound();render()}else{msg.textContent=t('code_bad');msg.className='msg err'}});
applyLanguage();
render();
</script>
</body>
</html>
