<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<title>🐰 Bunny — Кликер</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{margin:0;font-family:'Segoe UI',system-ui,sans-serif;background:linear-gradient(160deg,#a8e6cf 0%,#dcedc1 40%,#ffd3b6 100%);min-height:100vh;display:flex;flex-direction:column;align-items:center;user-select:none;padding-bottom:20px;overflow-x:hidden}
.header{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center;padding:10px}
h1{margin:0 0 10px;font-size:26px;color:#2e5d4b}
.wallet-panel{display:flex;justify-content:space-around;width:100%;background:#fff;border-radius:12px;padding:10px;box-shadow:0 3px 10px #0001;margin-bottom:10px;font-weight:700;color:#2e5d4b;flex-wrap:wrap;gap:5px;align-items:center}
.wallet-item{display:flex;align-items:center;gap:5px;font-size:15px}
.wallet-item svg{width:20px;height:20px}
.flying-box{position:fixed;width:40px;height:40px;pointer-events:none;z-index:999;animation:flyToNest .8s cubic-bezier(.25,1,.5,1) forwards}
@keyframes flyToNest{0%{transform:scale(1) translateY(0);opacity:1}100%{transform:scale(.2) translateY(-200px);opacity:0}}
.tabs{display:flex;gap:6px;margin:5px 0 10px;flex-wrap:wrap;justify-content:center}
.tab{padding:8px 16px;border:none;border-radius:12px;background:#fff8;font-size:15px;font-weight:600;color:#2e5d4b;cursor:pointer;transition:.2s;box-shadow:0 2px 6px #0002}
.tab.active{background:#ffb347;color:#fff;transform:scale(1.05)}
.panel{display:none;width:92%;max-width:420px;flex-direction:column;gap:15px;align-items:center}
.panel.active{display:flex}
.buffs-container{display:flex;flex-wrap:wrap;gap:5px;justify-content:center;margin-top:5px;min-height:30px}
.buff-tag{background:#ff9800;color:#fff;padding:4px 8px;border-radius:10px;font-size:11px;font-weight:bold;display:flex;gap:5px;align-items:center;box-shadow:0 2px 5px #0003}
.game-column{display:flex;flex-direction:column;align-items:center;width:100%;gap:10px}
.pets-around{position:absolute;width:100%;height:100%;pointer-events:none;top:0;left:0;z-index:2}
.pet-icon{position:absolute;font-size:40px;filter:drop-shadow(0 4px 6px #0004);animation:floatPet 3s ease-in-out infinite}
@keyframes floatPet{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
.bunny-wrap{display:flex;justify-content:center;align-items:center;position:relative;min-height:280px;width:100%}
.bunny-svg{width:200px;height:280px;cursor:pointer;filter:drop-shadow(0 8px 12px #0003);transform-origin:center bottom;z-index:1}
.bunny-svg.jump{animation:bunnyJump .35s ease-out}
@keyframes bunnyJump{0%{transform:translateY(0) scale(1)}30%{transform:translateY(-18px) scale(1.04,.96)}60%{transform:translateY(-6px) scale(.98,1.02)}100%{transform:translateY(0) scale(1)}}
.scientist-arm{transform-origin:150px 200px}
.bunny-svg.jump .scientist-arm{animation:shakeFlask .3s ease-in-out}
@keyframes shakeFlask{0%{transform:rotate(0)}25%{transform:rotate(-12deg)}50%{transform:rotate(8deg)}75%{transform:rotate(-4deg)}100%{transform:rotate(0)}}
.koschei-body{transform-origin:110px 200px}
.bunny-svg.jump .koschei-body{animation:boneRattle .4s ease-in-out}
@keyframes boneRattle{0%{transform:rotate(0)}20%{transform:rotate(-3deg)}40%{transform:rotate(3deg)}60%{transform:rotate(-2deg)}80%{transform:rotate(2deg)}100%{transform:rotate(0)}}
.energy-bar{height:22px;background:#fff9;border-radius:12px;overflow:hidden;box-shadow:inset 0 2px 4px #0002;position:relative;width:100%;max-width:340px;margin-top:-5px}
.energy-fill{height:100%;background:linear-gradient(90deg,#4facfe,#00f2fe);width:100%;transition:width .25s}
.energy-text{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:bold;color:#083}
.stat{text-align:center;font-size:15px;color:#2e5d4b;font-weight:600}
.flytrap-container{display:flex;flex-direction:column;align-items:center;cursor:pointer;position:relative;margin-top:-10px}
.flytrap-svg{width:100px;height:130px;transition:transform .2s,filter .3s;filter:drop-shadow(0 5px 10px #0004)}
.flytrap-svg:active{transform:scale(.95)}
.flytrap-svg.locked{filter:grayscale(100%) opacity(.4)}
.flytrap-info{text-align:center;font-size:13px;font-weight:bold;color:#2e5d4b;margin-top:2px;display:flex;align-items:center;justify-content:center;gap:4px}
.flytrap-info svg{width:16px;height:16px}
.bottom-panel{display:flex;align-items:flex-start;gap:10px;width:100%;margin-top:5px}
.buy-seed-card{background:#fff;border-radius:12px;padding:8px;box-shadow:0 3px 10px #0001;display:flex;flex-direction:column;align-items:center;gap:4px;width:90px;flex-shrink:0}
.buy-seed-card .box-icon{width:32px;height:32px}
.buy-seed-card .btn-buy{background:#4caf50;color:#fff;border:none;padding:6px;border-radius:8px;font-weight:bold;cursor:pointer;width:100%;font-size:11px}
.nest-area{background:#8b5a2b;border-radius:12px;padding:8px;display:flex;flex-wrap:wrap;gap:5px;justify-content:center;min-height:80px;border:4px solid #5a3a1a;flex:1}
.nest-slot{width:34px;height:34px;background:rgba(0,0,0,.2);border-radius:6px;display:flex;align-items:center;justify-content:center;cursor:pointer;position:relative}
.nest-slot.empty{color:#fff3;font-size:14px}
.nest-slot svg{width:26px;height:26px}
.nest-slot.timer::after{content:attr(data-time);position:absolute;bottom:-11px;font-size:9px;color:#fff;font-weight:bold;text-shadow:0 1px 2px #000}
.card{background:#fff;border-radius:14px;padding:12px 14px;box-shadow:0 3px 10px #0001;display:flex;flex-direction:column;gap:4px;width:100%}
.card .row{display:flex;justify-content:space-between;align-items:center}
.card .name{font-weight:700;color:#2e5d4b;font-size:16px}
.card .lvl{font-size:13px;color:#888}
.card .desc{font-size:13px;color:#555}
button.buy{border:none;border-radius:10px;padding:8px 14px;font-weight:700;background:#4caf50;color:#fff;cursor:pointer;transition:.2s;font-size:14px}
button.buy:disabled{background:#bbb;cursor:not-allowed}
button.equip{background:#2196f3}
button.equipped{background:#ff9800}
.skin-card{background:#fff;border-radius:14px;padding:10px;box-shadow:0 3px 10px #0001;display:flex;align-items:center;gap:12px;width:100%}
.skin-thumb{width:70px;height:90px;flex-shrink:0;border-radius:10px;display:flex;align-items:center;justify-content:center;overflow:hidden;border:3px solid #eee}
.skin-thumb svg{width:60px;height:80px}
.skin-thumb[data-id="0"]{border-color:#ddd;background:#fff}
.skin-thumb[data-id="1"]{border-color:#3498db;background:#e3f2fd}
.skin-thumb[data-id="2"]{border-color:#f1c40f;background:#fff9c4}
.skin-thumb[data-id="3"]{border-color:#c0392b;background:#ffebee}
.skin-thumb[data-id="4"]{border-color:#2c3e50;background:#eceff1}
.skin-thumb[data-id="5"]{border-color:#1e3a8a;background:#e8eaf6}
.skin-thumb[data-id="6"]{border-color:#8e44ad;background:#f3e5f5}
.skin-thumb[data-id="7"]{border-color:#2c2c2c;background:#e0e0e0}
.skin-info{flex:1;display:flex;flex-direction:column;gap:4px}
.skin-info .name{font-weight:700;color:#2e5d4b;font-size:15px}
.skin-info .price{font-size:12px;color:#888}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);display:none;justify-content:center;align-items:center;z-index:1000}
.modal-overlay.active{display:flex}
.modal-box{background:#fff;padding:20px;border-radius:16px;text-align:center;max-width:300px;animation:popIn .3s cubic-bezier(.175,.885,.32,1.275)}
@keyframes popIn{0%{transform:scale(.5);opacity:0}100%{transform:scale(1);opacity:1}}
.modal-title{font-size:20px;font-weight:bold;margin-bottom:10px;color:#2e5d4b}
.modal-icon{width:80px;height:80px;margin:10px auto}
.modal-desc{font-size:16px;color:#555;margin-bottom:15px}
.modal-btn{background:#4caf50;color:#fff;border:none;padding:10px 20px;border-radius:10px;font-weight:bold;cursor:pointer;width:100%}
.float-coin{position:absolute;font-size:26px;font-weight:800;color:#ff9800;text-shadow:0 2px 4px #0003,0 0 8px #fff8;pointer-events:none;animation:floatUp .9s ease-out forwards;z-index:10;transform:translate(-50%,-50%)}
@keyframes floatUp{0%{opacity:1;transform:translate(-50%,-50%) scale(.6)}30%{opacity:1;transform:translate(-50%,-80%) scale(1.15)}100%{opacity:0;transform:translate(-50%,-200%) scale(1)}}
.blood-spark{position:absolute;pointer-events:none;z-index:12;border-radius:50%;background:radial-gradient(circle,#ff3030 0%,#c00000 40%,transparent 70%);box-shadow:0 0 8px #ff0000;animation:bloodSpark .5s ease-out forwards;transform:translate(-50%,-50%)}
@keyframes bloodSpark{0%{opacity:1;width:8px;height:8px}100%{opacity:0;width:35px;height:35px}}
.friday-glow{filter:drop-shadow(0 0 8px #b00000) drop-shadow(0 8px 12px #0003)!important}
.koschei-glow{filter:drop-shadow(0 0 10px #8b0000) drop-shadow(0 8px 12px #0003)!important}
.settings-btn{position:fixed;top:10px;right:10px;width:44px;height:44px;border-radius:50%;border:none;background:#fff;font-size:22px;box-shadow:0 3px 10px #0002;cursor:pointer;z-index:100;transition:transform .2s}
.settings-btn:active{transform:scale(.9) rotate(30deg)}
.settings-box{background:#fff;padding:22px;border-radius:18px;max-width:320px;width:90%;animation:popIn .3s cubic-bezier(.175,.885,.32,1.275)}
.settings-box h3{margin:0 0 15px;color:#2e5d4b;text-align:center;font-size:20px}
.settings-row{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid #eee}
.settings-row:last-of-type{border-bottom:none}
.settings-row .label{font-weight:600;color:#2e5d4b;font-size:15px}
.settings-row .value{font-weight:700;color:#ff9800;font-size:15px}
.settings-btn-sm{background:#2196f3;color:#fff;border:none;padding:7px 14px;border-radius:10px;font-weight:700;cursor:pointer;font-size:13px}
.volume-slider{width:140px;accent-color:#4caf50;cursor:pointer}
.lang-choice{display:flex;gap:10px;margin-top:10px}
.lang-btn{flex:1;background:#f0f0f0;color:#2e5d4b;border:2px solid #ddd;padding:12px;border-radius:12px;font-weight:700;cursor:pointer;font-size:15px;transition:.2s}
.lang-btn.active{background:#ffb347;color:#fff;border-color:#ff9800}
.lang-btn:active{transform:scale(.95)}
</style>
</head>
<body>
<button class="settings-btn" id="settingsBtn" title="Settings">⚙️</button>
<div class="header">
<h1>🐰 Bunny</h1>
<div class="wallet-panel">
<div class="wallet-item">💰 <span id="coins">0</span></div>
<div class="wallet-item"><span id="seedIconContainer"></span><span id="seeds">0</span></div>
<div class="wallet-item" id="overflowBoxes" style="display:none">📦 <span id="boxCount">0</span></div>
</div>
<div class="tabs">
<button class="tab active" data-tab="clicker" data-i18n="tab_clicker">Кликер</button>
<button class="tab" data-tab="upgrade" data-i18n="tab_upgrade">Прокачка</button>
<button class="tab" data-tab="skins" data-i18n="tab_skins">Скины</button>
<button class="tab" data-tab="codes" data-i18n="tab_codes">Коды</button>
</div>
</div>
<div class="panel active" id="panel-clicker">
<div class="buffs-container" id="buffsContainer"></div>
<div class="game-column">
<div class="bunny-wrap" id="bunnyWrap">
<div id="petsAround" class="pets-around"></div>
<div id="bunnyContainer"></div>
</div>
<div class="energy-bar"><div class="energy-fill" id="energyFill"></div><div class="energy-text" id="energyText">20 / 20</div></div>
<div class="stat"><span data-i18n="stat_click">За клик</span>: <span id="clickValue">1</span> 🪙</div>
<div class="stat"><span data-i18n="stat_passive">В секунду</span>: <span id="passiveValue">1</span> 🪙</div>
<div class="flytrap-container" id="flytrapContainer" onclick="handleFlytrapClick()">
<svg viewBox="0 0 100 120" class="flytrap-svg locked" id="flytrapSvg">
<path d="M50 120 Q45 90 50 70" stroke="#4caf50" stroke-width="6" fill="none" stroke-linecap="round"/>
<path d="M50 90 Q35 85 30 75" stroke="#4caf50" stroke-width="4" fill="none" stroke-linecap="round"/>
<path d="M50 95 Q65 90 70 80" stroke="#4caf50" stroke-width="4" fill="none" stroke-linecap="round"/>
<path d="M25 70 Q20 40 50 30 Q80 40 75 70 Q50 85 25 70 Z" fill="#e74c3c" stroke="#8b0000" stroke-width="2"/>
<path d="M25 70 L35 55 L45 70 L55 55 L65 70 L75 55" stroke="#27ae60" stroke-width="3" fill="none" stroke-linejoin="round"/>
<path d="M30 50 L33 58 L36 50 Z" fill="#fff"/><path d="M45 45 L48 53 L51 45 Z" fill="#fff"/><path d="M60 50 L63 58 L66 50 Z" fill="#fff"/>
<path d="M40 60 L42 68 L44 60 Z" fill="#fff"/><path d="M55 60 L57 68 L59 60 Z" fill="#fff"/>
</svg>
<div class="flytrap-info" id="flytrapInfo"></div>
</div>
<div class="bottom-panel">
<div class="buy-seed-card">
<div id="shopSeedIcon"></div>
<div style="font-weight:bold;font-size:11px;color:#555" data-i18n="one_seed">1 Семечко</div>
<button class="btn-buy" id="buySeedBtn" onclick="buySeed()">10M 🪙</button>
</div>
<div class="nest-area" id="nestArea"></div>
</div>
</div>
</div>
<div class="panel" id="panel-upgrade">
<div class="card"><div class="row"><span class="name" data-i18n="up_click_name">👆 Клик</span><span class="lvl" id="lvl-click">Ур. 1 / 20</span></div><div class="desc"><span data-i18n="up_click_desc">Монет за клик</span>: <b id="desc-click">1</b></div><button class="buy" id="buy-click" data-i18n="btn_upgrade">Улучшить</button></div>
<div class="card"><div class="row"><span class="name" data-i18n="up_passive_name">💸 Прибыль в секунду</span><span class="lvl" id="lvl-passive">Ур. 1 / 20</span></div><div class="desc"><span data-i18n="up_passive_desc">Монет в секунду</span>: <b id="desc-passive">1</b></div><button class="buy" id="buy-passive" data-i18n="btn_upgrade">Улучшить</button></div>
<div class="card"><div class="row"><span class="name" data-i18n="up_energy_name">⚡ Энергия</span><span class="lvl" id="lvl-energy">Ур. 1 / 20</span></div><div class="desc"><span data-i18n="up_energy_desc">Макс. энергия</span>: <b id="desc-energy">20</b></div><button class="buy" id="buy-energy" data-i18n="btn_upgrade">Улучшить</button></div>
</div>
<div class="panel" id="panel-skins">
<div class="skin-card"><div class="skin-thumb" data-id="0" id="thumb-0"></div><div class="skin-info"><span class="name" data-i18n="skin_0">Обычный кролик</span><span class="price" data-i18n="skin_0_price">Базовый</span><button class="buy equip equipped" id="skin-btn-0" data-i18n="btn_equipped">Надет</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="1" id="thumb-1"></div><div class="skin-info"><span class="name" data-i18n="skin_1">Крутой кролик</span><span class="price" id="price-1"></span><button class="buy" id="skin-btn-1" data-i18n="btn_buy">Купить</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="2" id="thumb-2"></div><div class="skin-info"><span class="name" data-i18n="skin_2">Кролик фараон</span><span class="price" id="price-2"></span><button class="buy" id="skin-btn-2" data-i18n="btn_buy">Купить</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="3" id="thumb-3"></div><div class="skin-info"><span class="name" data-i18n="skin_3">Кролик пират</span><span class="price" id="price-3"></span><button class="buy" id="skin-btn-3" data-i18n="btn_buy">Купить</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="4" id="thumb-4"></div><div class="skin-info"><span class="name" data-i18n="skin_4">Пятница 13</span><span class="price" id="price-4"></span><button class="buy" id="skin-btn-4" data-i18n="btn_buy">Купить</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="5" id="thumb-5"></div><div class="skin-info"><span class="name" data-i18n="skin_5">Император</span><span class="price" id="price-5"></span><button class="buy" id="skin-btn-5" data-i18n="btn_buy">Купить</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="6" id="thumb-6"></div><div class="skin-info"><span class="name" data-i18n="skin_6">Учёный кролик</span><span class="price" id="price-6"></span><button class="buy" id="skin-btn-6" data-i18n="btn_buy">Купить</button></div></div>
<div class="skin-card"><div class="skin-thumb" data-id="7" id="thumb-7"></div><div class="skin-info"><span class="name" data-i18n="skin_7">Кощей</span><span class="price" id="price-7"></span><button class="buy" id="skin-btn-7" data-i18n="btn_buy">Купить</button></div></div>
</div>
<div class="panel" id="panel-codes">
<input class="code-input" id="codeInput" placeholder="Введи код..." data-i18n="code_placeholder" style="padding:12px;border-radius:12px;border:2px solid #ffb347;font-size:16px;width:100%">
<button class="code-btn" id="codeBtn" data-i18n="code_activate" style="padding:12px;border-radius:12px;border:none;background:#ffb347;color:#fff;font-size:16px;font-weight:700;cursor:pointer;margin-top:5px;width:100%">Активировать</button>
<div class="msg" id="codeMsg" style="font-size:14px;font-weight:600;text-align:center;min-height:20px"></div>
</div>
<div class="modal-overlay" id="modalOverlay" onclick="closeModal()">
<div class="modal-box" onclick="event.stopPropagation()">
<div class="modal-title" id="modalTitle">Открытие</div>
<div class="modal-icon" id="modalIcon"></div>
<div class="modal-desc" id="modalDesc">Вы получили...</div>
<button class="modal-btn" onclick="closeModal()" data-i18n="btn_take">Забрать</button>
</div>
</div>
<div class="modal-overlay" id="settingsOverlay" onclick="closeSettings()">
<div class="settings-box" onclick="event.stopPropagation()">
<h3 data-i18n="settings_title">⚙️ Настройки</h3>
<div class="settings-row"><span class="label" data-i18n="settings_lang">Язык</span><button class="settings-btn-sm" id="changeLangBtn" data-i18n="settings_change">Изменить</button></div>
<div id="langChoice" style="display:none"><div class="lang-choice">
<button class="lang-btn active" id="langRu" onclick="setLanguage('ru')">🇷🇺 Русский</button>
<button class="lang-btn" id="langEn" onclick="setLanguage('en')">🇬🇧 English</button>
</div></div>
<div class="settings-row"><span class="label" data-i18n="settings_volume">Громкость</span><input type="range" class="volume-slider" id="volumeSlider" min="0" max="100" value="100"></div>
<div class="settings-row"><span class="label" data-i18n="settings_volume_val">Звук</span><span class="value" id="volumeValue">100%</span></div>
</div>
</div>
<script>
